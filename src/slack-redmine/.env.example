# Slack bot token (OAuth & Permissions -> Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-...

# Slack app-level token with connections:write scope (Basic Information -> App-Level Tokens)
SLACK_APP_TOKEN=xapp-...

# Redmine base URL, no trailing slash
REDMINE_URL=https://redmine.example.com

# API key of the Redmine bot user.
# Use an admin user's key to enable default-assignee-by-email matching.
REDMINE_API_KEY=...
